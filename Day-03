#include <stdio.h>

int main()
{
    char a[1000];
    int c = 0;
    int word = 0;

    fgets(a, 1000, stdin);

    for(int i = 0; a[i] != '\0'; i++)
    {
        if(a[i] != ' ' && word == 0)
        {
            c++;
            word = 1;
        }

        if(a[i] == ' ')
        {
            word = 0;
        }
    }

    printf("Number of words = %d", c);

    return 0;
}
