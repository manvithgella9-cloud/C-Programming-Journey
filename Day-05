scanf("%s",p);
for(i=0;i<strlen(s);i++)
{
    c=0;
    for(j=0;j<strlen(p);j++)
    {
        if(s[i]==p[j] && r[j]==0)
        {
            c++;
            r[j]=1;
            break;
        }
    }
    if(c==1)
     m++;
}
if(m==strlen(s))
printf("anagram");
else
printf("not anagram");

return 0;
}

