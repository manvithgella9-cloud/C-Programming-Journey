#include<string.h>
int main()
{
    char a[1000];
    int i,c,r[1000]={0},j;
    scanf("%s",a);
    for(i=0;i<strlen(a);i++)
    {
        if(r[i]==1)
        continue;
        printf("%c:",a[i]);
      c=0;
      for(j=i;j<strlen(a);j++)
      {
          if(a[i]==a[j] && r[j]==0)
          {
          c++;
          r[j]=1;
          }
      }
      printf(" %d\n",c);
    }

    return 0;
}
