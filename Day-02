#include <stdio.h>
#include<string.h>

int main()
{
    char a[1000];
    int i=0,flag=1;
    printf("enter string:");
    scanf("%s",a);
    int j=strlen(a)-1;
     while(i<j)
    {
        if(a[i]!=a[j])
        {
            flag=0;
            break;
        }
        i++;
        j--;
    }
    if(flag==1)
    printf("palindrome");
    else
  printf("not palindrome");
    return 0;
}
